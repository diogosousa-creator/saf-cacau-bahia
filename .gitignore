.venv/
__pycache__/
*.py[cod]
.DS_Store

# Dados e artefatos locais
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/archive/*
!data/archive/.gitkeep
data/processed/*
!data/processed/.gitkeep
tmp/*
!tmp/.gitkeep

# Streamlit
.streamlit/secrets.toml

# Publicação WebGIS: somente os artefatos compactos efetivamente servidos pelo
# aplicativo. As fontes brutas, versões históricas e geometrias analíticas
# completas permanecem locais.
!data/processed/assessments.parquet
!data/processed/bahia_boundary.geojson
!data/processed/bahia_exterior_mask.geojson
!data/processed/fazendas_apresentacao_parcelas_detalhe_lookup.parquet
!data/processed/municipios_ranking_base.parquet
!data/processed/municipios_hex_pesos.parquet
!data/processed/municipios_imoveis.parquet

